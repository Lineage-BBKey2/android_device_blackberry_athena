<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreference
        android:key="keyboard_pin_input"
        android:title="@string/keyboard_pin_input_title"
        android:summary="@string/keyboard_pin_input_summary"
        android:defaultValue="true" />

    <SwitchPreference
        android:key="show_ime_with_hard_keyboard"
        android:title="@string/show_ime_title"
        android:summary="@string/show_ime_summary"
        android:defaultValue="true" />

    <ListPreference
        android:key="ime_switcher_shortcut"
        android:title="@string/ime_switcher_shortcut_title"
        android:summary="@string/ime_switcher_shortcut_summary"
        android:entries="@array/ime_switcher_shortcut_entries"
        android:entryValues="@array/ime_switcher_shortcut_values"
        android:defaultValue="0" />

    <PreferenceCategory
        android:key="keyboard_backlight_category"
        android:title="@string/keyboard_backlight_category">

        <SwitchPreference
            android:key="keyboard_adaptive_brightness"
            android:title="@string/keyboard_adaptive_brightness_title"
            android:summary="@string/keyboard_adaptive_brightness_summary"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="keyboard_brightness"
            android:title="@string/keyboard_brightness_title"
            android:summary="@string/keyboard_brightness_summary"
            android:max="100"
            android:defaultValue="100" />

        <ListPreference
            android:key="keyboard_backlight_timeout"
            android:title="@string/keyboard_backlight_timeout_title"
            android:summary="@string/keyboard_backlight_timeout_summary"
            android:entries="@array/backlight_timeout_entries"
            android:entryValues="@array/backlight_timeout_values"
            android:defaultValue="0" />

        <SwitchPreference
            android:key="keyboard_backlight_only_when_pressed"
            android:title="@string/keyboard_only_when_pressed_title"
            android:summary="@string/keyboard_only_when_pressed_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="button_backlight_category"
        android:title="@string/button_backlight_category">

        <SwitchPreference
            android:key="button_adaptive_brightness"
            android:title="@string/button_adaptive_brightness_title"
            android:summary="@string/button_adaptive_brightness_summary"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="button_brightness"
            android:title="@string/button_brightness_title"
            android:summary="@string/button_brightness_summary"
            android:max="100"
            android:defaultValue="100" />

        <ListPreference
            android:key="button_backlight_timeout"
            android:title="@string/button_backlight_timeout_title"
            android:summary="@string/button_backlight_timeout_summary"
            android:entries="@array/backlight_timeout_entries"
            android:entryValues="@array/backlight_timeout_values"
            android:defaultValue="5000" />

        <SwitchPreference
            android:key="button_only_when_pressed"
            android:title="@string/button_only_when_pressed_title"
            android:summary="@string/button_only_when_pressed_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
