<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/legacy_apk_explanation"
            android:textAppearance="@style/TextAppearance.PreferenceTitle.SettingsLib"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/legacy_apk_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.PreferenceTitle.SettingsLib"
            android:textStyle="normal" />
        <ProgressBar
            android:id="@+id/legacy_apk_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100" />
        <Button
            android:id="@+id/legacy_apk_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/legacy_apk_download" />
        <Button
            android:id="@+id/legacy_apk_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/legacy_apk_cancel_download" />
    </LinearLayout>
</ScrollView>
