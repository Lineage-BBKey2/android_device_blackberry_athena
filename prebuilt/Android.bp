android_app_import {
    name: "K12KB",
    apk: "K12KB.apk",
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "Lokker",
    apk: "Lokker.apk",
    presigned: true,
    preprocessed: true,
    privileged: true,
    dex_preopt: {
        enabled: false,
    },
    system_ext_specific: true,
    required: ["com.lokker.app.privapp-permissions"],
}

prebuilt_etc {
    name: "com.lokker.app.privapp-permissions",
    src: "com.lokker.app.privapp-permissions.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
